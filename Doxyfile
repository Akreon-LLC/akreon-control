PROJECT_NAME           = "akreon-control"
PROJECT_BRIEF          = "General-purpose optimal and robust control and state estimation"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = include/akreon bindings/c/include docs/ARCHITECTURE.md docs/ROADMAP.md
FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */docs/doxygen/*
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
USE_MDFILE_AS_MAINPAGE = docs/ARCHITECTURE.md
QUIET                  = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Graphviz output
#
# Generate call and dependency graphs with bounded breadth/depth for the
# template-heavy headers. SVG output keeps
# generated diagrams readable when zoomed in browser docs.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_NUM_THREADS        = 0
DOT_GRAPH_MAX_NODES    = 80
MAX_DOT_GRAPH_DEPTH    = 3

# Type and hierarchy graphs
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
GRAPHICAL_HIERARCHY    = YES
GROUP_GRAPHS           = YES

# Function call trees
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# Dependency trees
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
