{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-default",
      "displayName": "Host Default",
      "description": "Host build with unit and functional tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/host-default",
      "cacheVariables": {
        "BUILD_UNIT_TESTS": "ON",
        "BUILD_FUNCTIONAL_TESTS": "ON"
      }
    },
    {
      "name": "host-sanitized",
      "displayName": "Host Sanitized",
      "description": "Host C++ tests and examples with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "host-default",
      "binaryDir": "${sourceDir}/out/build/host-sanitized",
      "cacheVariables": {
        "AKREON_CONTROL_ENABLE_SANITIZERS": "ON",
        "AKREON_CONTROL_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "host-functional-only",
      "displayName": "Host Functional Only",
      "description": "Host build without unit tests/Catch2",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/host-functional-only",
      "cacheVariables": {
        "BUILD_UNIT_TESTS": "OFF",
        "BUILD_FUNCTIONAL_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-default",
      "configurePreset": "host-default"
    },
    {
      "name": "host-sanitized",
      "configurePreset": "host-sanitized"
    },
    {
      "name": "host-functional-only",
      "configurePreset": "host-functional-only"
    }
  ],
  "testPresets": [
    {
      "name": "host-sanitized",
      "configurePreset": "host-sanitized",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
